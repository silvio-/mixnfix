<?xml version="1.0" encoding="ASCII"?><prova><config index="0" numerodedigitosid="2"/><cabeçalho><mat modo="tex">Universidade Federal de Pernambuco\\ 
</mat><mat modo="tex">Centro de Inform&#225;tica \\
</mat><mat modo="tex">&#193;lgebra Vetorial e Linear Para Computa&#231;&#227;o\\ 
</mat><mat modo="tex">Segundo Exerc&#237;cio Escolar - 25-01-2007\\ 
</mat></cabeçalho><quesito tag="1.0" acerto="1.000" tipo="falso/verdadeiro" falha="-1.000"><enunciado><mat modo="tex">Considere os seguintes conjuntos: $A=\{(x,y,z)\in I\hspace{-1mm}R^3|z=0\ e\ x+2y&lt;3\}$ e $B=\{(x,y,z)\in I\hspace{-1mm}R^3|2x+4y+5z=0\} $. Responda V ou F:</mat></enunciado><item tag="item 1" resposta="f"><mat modo="tex">$A$ &#233; subespa&#231;o vetorial do $I\hspace{-1mm}R^3$.</mat></item><item tag="item 2" resposta="v"><mat modo="tex">$B$ &#233; subespa&#231;o vetorial do $I\hspace{-1mm}R^3$.</mat></item><item tag="item 3" resposta="v"><mat modo="tex">$A\cap B$ &#233; subespa&#231;o vetorial do $I\hspace{-1mm}R^3$.</mat></item><item tag="item 4" resposta="f"><mat modo="tex">$A\cup B$ &#233; subespa&#231;o vetorial do $I\hspace{-1mm}R^3$.</mat></item></quesito><quesito tag="1.0" acerto="2.000" tipo="alternativas" resposta="A" falha="-2.000"><enunciado><mat modo="tex">Considere os seguintes subespa&#231;os do $I\hspace{-1mm}R^3$: $U=[(1,1,0)]$ e $W=\{(x,y,z)\in I\hspace{-1mm}R^3|\left\{\begin{array}{c}x+y+z=0\cr 2x-y-z=0 \end{array}\right.\}$. Ent&#227;o U+W &#233; igual a:</mat></enunciado><item tag="item 1"><mat modo="tex">$\{(x,y,z)\in I\hspace{-1mm}R^3|y+z-x=0\}$</mat></item><item tag="item 2"><mat modo="tex">$I\hspace{-1mm}R^3$</mat></item><item tag="item 3"><mat modo="tex">$\{(x,y,z)\in I\hspace{-1mm}R^3|\left\{\begin{array}{c}x+y+z=0\cr 2x-y-z=0 \cr x-y=0\end{array}\right.\}$</mat></item><item tag="item 4"><mat modo="tex">$\{(x,y,z)\in I\hspace{-1mm}R^3|x+y+z=0\}$</mat></item><item tag="item 5"><mat modo="tex">$\{(x,y,z)\in I\hspace{-1mm}R^3|x=0\}$</mat></item><item tag="item 6"><mat modo="tex">$W$</mat></item></quesito><quesito tag="1.0" acerto="2.000" tipo="falso/verdadeiro" falha="-2.000"><enunciado><mat modo="tex">Assinale (V) se o conjunto indicado for subespa&#231;o vetorial e (F) caso contr&#225;rio:</mat></enunciado><item tag="item 1" resposta="f"><mat modo="tex">$\{(x,y,z)\in I\hspace{-1mm}R^3| ||(x,y,z)||=1\}$</mat></item><item tag="item 2" resposta="f"><mat modo="tex">$\{(x,y)\in I\hspace{-1mm}R^2|y=|x|\}$</mat></item><item tag="item 3" resposta="v"><mat modo="tex">$\{(x,y,z,w)\in I\hspace{-1mm}R^4|x=2y+3z\ e\ w=0\}$</mat></item><item tag="item 4" resposta="f"><mat modo="tex">$\{A\in M_{2\times 2}|$ um elemento de A &#233; nulo $\}$.</mat></item><item tag="item 5" resposta="v"><mat modo="tex">$\{A\in M_{2\times 2}|$ o elemento $A_{21}$ &#233; nulo $\}$.</mat></item><item tag="item 6" resposta="f"><mat modo="tex">$\{A\in M_{2\times 2}| det(A)=0 \}$.</mat></item><item tag="item 7" resposta="v"><mat modo="tex">$\{A\in M_{2\times 2}| A$ &#233; matriz sim&#233;trica $\}$.</mat></item><item tag="item 8" resposta="v"><mat modo="tex">$\{v\in I\hspace{-1mm}R^3| v\bot(1,1,2)\}$</mat></item></quesito><quesito tag="1.0" acerto="2.000" tipo="falso/verdadeiro" falha="-2.000"><enunciado><mat modo="tex">Assinale em cada alternativa (V) se o conjunto de vetores for uma base para o espa&#231;o indicado, e (F) caso contr&#225;rio:
</mat></enunciado><item tag="item 1" resposta="v"><mat modo="tex">$\{(1,3),(2,a)\}; I\hspace{-1mm}R^2$, onde $a\in I\hspace{-1mm}R$, com $a\neq 6$.</mat>
</item><item tag="item 2" resposta="v"><mat modo="tex">$\{(0,1,1),(1,0,1),(1,1,0)\}; I\hspace{-1mm}R^3$.
</mat></item><item tag="item 3" resposta="f"><mat modo="tex">$\{\left(\begin{array}{cc}1&amp;1\cr 0&amp;0 \end{array}\right), \left(\begin{array}{cc}0&amp;0\cr 1&amp;1 \end{array}\right),\left(\begin{array}{cc}2&amp;2\cr -1&amp;-1 \end{array}\right)\}; W=\{\left(\begin{array}{cc}x&amp;y\cr z&amp;w \end{array}\right)\in M_{2\times 2}|\left\{\begin{array}{c}x=y\cr z=w \end{array}\right.\}$</mat></item><item tag="item 4" resposta="v"><mat modo="tex">$\{p_0(t),\ p_1(t),\ p_2(t)\}; P_2$, onde $p_i(t)$ &#233; um polin&#244;mio de grau $i$.</mat></item><item tag="item 5" resposta="f"><mat modo="tex">$\{(1,2,-1),(-2,-4,2)\}; U=\{(x,y,z)\in I\hspace{-1mm}R^3|x+y+3z=0\}$</mat></item></quesito><quesito tag="1.0" acerto="1.000" tipo="falso/verdadeiro" falha="-1.000"><enunciado><mat modo="tex">Considere um sistema $AX=b$, com mais de uma inc&#243;gnita, onde o posto da matriz $A$ &#233; $p$, o posto da matriz ampliada &#233; $P$, a nulidade de $A$ &#233; $n$ e a nulidade da ampliada &#233; $N$. Assinale (V) ou (F):</mat></enunciado><item tag="item 1" resposta="v"><mat modo="tex">Se $N=n$ ent&#227;o o sistema n&#227;o admite solu&#231;&#245;es</mat>.</item><item tag="item 2" resposta="f"><mat modo="tex">Se $b=0$ ent&#227;o $N=n$.</mat></item><item tag="item 3" resposta="f"><mat modo="tex">Se $P=1$ ent&#227;o o sistema admite infinitas solu&#231;&#245;es.</mat></item><item tag="item 4" resposta="v"><mat modo="tex">A matriz $A$ pode n&#227;o ser quadrada e mesmo assim o sistema pode admitir solu&#231;&#227;o &#250;nica.</mat></item><item tag="item 5" resposta="f"><mat modo="tex">Se $N$ coincide com o n&#250;mero de colunas de $A$, ent&#227;o o conjunto - solu&#231;&#227;o coincide com o conjunto inteiro de &#234;nuplas ao qual as solu&#231;&#245;es pertencem.</mat></item></quesito><quesito tag="1.0" acerto="1.000" tipo="num&#233;rico_99" resposta="8" falha="-1.000"><enunciado><mat modo="tex">Considere a matriz $A=\left(\begin{array}{ccc}1&amp;2&amp;2\cr 1&amp;0&amp;1\cr 0&amp;1&amp;2 \end{array}\right)$. O triplo da soma dos quadrados de todos os elementos de $A^{-1}$ &#233;:</mat></enunciado></quesito><quesito tag="1.0" acerto="1.000" tipo="alternativas" resposta="A" falha="-1.000"><enunciado><mat modo="tex">Considere o sistema com solu&#231;&#245;es em $I\hspace{-1mm}R^5$ dado por: $\left\{\begin{array}{c}3x_2-x_3=0\cr x_2+x_3+x_4=0\cr 3x_3-x_2+2x_4=0 \end{array}\right.$ Uma descri&#231;&#227;o param&#233;trica de suas solu&#231;&#245;es &#233; (com $r,s,t\in I\hspace{-1mm}R$):</mat></enunciado><item tag="item 1"><mat modo="tex">$(t,-\frac{1}{4}s,-\frac{3}{4}s,s,r)$</mat></item><item tag="item 2"><mat modo="tex">$(0,-\frac{1}{4}t,-\frac{3}{4}t,t,0)$</mat></item><item tag="item 3"><mat modo="tex">$(0,t,s,\frac{1}{4}t+\frac{3}{4}s,0)$</mat></item><item tag="item 4"><mat modo="tex">$(r,-t,-3t,4t,t)$</mat></item><item tag="item 5"><mat modo="tex">$(t,-s,-3s,4s,t+s)$</mat></item></quesito></prova>